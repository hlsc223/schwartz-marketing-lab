---
import Layout from '../../layouts/Layout.astro';

const hero = {
  title: 'The 2026 Modern Organic Growth Playbook',
  subhead: 'Organic traffic cratered for companies during the AI-era shift, while others grew dramatically. This report examines the successes and failures for a complete look at how to create durable demand in 2026 and beyond.',
  overview: 'The study followed 118 B2B SaaS companies through one of the largest shifts in modern search, revealing the decisions winners and losers took to end up on opposite sides of the traffic split.',
  whyP1: "Don't let anyone tell you that AI killed search. What it actually killed was a category of demand that ChatGPT, Claude, and AI Overviews can satisfy without sending anyone to your website.\n\nThis playbook details how you can reimagine your strategy to create durable demand in 2026. You'll learn how to recover lost traffic, accelerate growth, and become the definitive answer when someone asks AI a question about your vertical.",
};

const stats = [
  { value: '118', label: 'Companies tracked' },
  { value: '18 mo', label: 'Data window' },
  { value: '6', label: 'B2B SaaS verticals' },
  { value: '47%', label: 'Declined' },
  { value: '37%', label: 'Grew' },
  { value: '16%', label: 'Stayed flat' },
];

const maxVal = 22;
const rawBars = [
  { label: 'Decreased by more than 50%', value: 15, group: 'declined' },
  { label: 'Decreased by 50% to 25%',    value: 22, group: 'declined' },
  { label: 'Decreased by 25% to 10%',    value: 18, group: 'declined' },
  { label: 'Between 10% loss and 10% growth', value: 19, group: 'flat' },
  { label: 'Increased by 10% to 25%',    value: 9,  group: 'grew' },
  { label: 'Increased by 25% to 50%',    value: 12, group: 'grew' },
  { label: 'Increased by more than 50%', value: 21, group: 'grew' },
];
const chartBars = rawBars.map(b => ({
  ...b,
  heightPct: Math.max(6, Math.round((b.value / maxVal) * 100)) + '%',
}));

const findings = [
  { n: '01', title: 'Most organic strategies are outdated.', body: "Of 118 companies tracked, 63% lost traffic or remained stagnant. That's because strategies that worked even 12 months ago are no longer effective. In most cases, they actually work against you." },
  { n: '02', title: "More isn't always better.", body: "Publishing frequency, domain authority, and backlink counts showed no meaningful correlation with growth direction. What did was something most programs don't measure." },
  { n: '03', title: 'Renewable demand is the ultimate unlock.', body: "Over 60% of content-driven growers built for a category of demand where new audiences continuously arrive. Most content programs don't account for it. The ones that do are the ones that win." },
  { n: '04', title: "Rankings don't always lead to traffic.", body: 'We saw an unusual pattern in many companies: rankings held or improved while traffic fell. It turns out that the cause is specific and identifiable — and so are the pages most at risk.' },
  { n: '05', title: 'AI answers more queries than you realize.', body: "AI Overview exposure followed a pattern. It traces back to a single structural characteristic of the query, and it's something you can screen your own content against." },
];

const audience = [
  { label: 'B2B SaaS marketing leaders', body: 'If your organic traffic behaves differently than it did 18 months ago, this playbook explains why and what to do about it.' },
  { label: 'Growth and content teams', body: "If you're building or rebuilding an organic program, this gives you evidence on what actually works rather than conventional wisdom on what used to work." },
  { label: 'SEOs and organic strategists', body: 'This playbook gives operators a research-backed diagnostic framework to distinguish between the various forces holding your traffic back or pushing it forward.' },
];

const chapters = [
  { n: '01', title: 'What Happened to B2B Traffic', body: 'Why 47% of companies declined and 37% grew simultaneously, and the primary forces that drove the split.' },
  { n: '02', title: "Assumptions That Didn't Survive the Data", body: 'This study contradicted four widely held organic growth assumptions operators have been working from for years.' },
  { n: '03', title: 'What Your Traffic Number Hides', body: "Your traffic number might be lying to you. Here's how to determine how healthy your program really is." },
  { n: '04', title: 'Which Force Hit You', body: 'A diagnostic framework for identifying which of five distinct mechanisms caused traffic to decrease.' },
  { n: '05', title: 'The Foundation of Durable Demand', body: 'What growing companies shared: content type, distribution pattern, and structurally renewable demand.' },
  { n: '06', title: 'When Growth Starts to Crack', body: 'Three hidden risks appeared repeatedly across growing companies in our cohort.' },
  { n: '07', title: 'How Companies Actually Recovered', body: 'Two recovery archetypes observed in the cohort, and how to identify which applies.' },
  { n: '08', title: "When Recovery Isn't the Right Strategy", body: "Three structural decline patterns where the standard recovery playbook doesn't apply and what to do instead." },
  { n: '09', title: 'Understanding AI Visibility', body: 'Direct evidence from the cohort on how answer engines affect B2B traffic.' },
  { n: '10', title: 'Building for AI Visibility', body: 'What the citation data shows about how AI answer engines select sources.' },
  { n: '11', title: 'The Durable Demand Playbook', body: 'Four durability tiers and a STOP / DE-RISK / DOUBLE DOWN prioritization model.' },
];
---

<Layout
  title="The 2026 Modern Organic Growth Playbook | S.LAB"
  description="Original research across 118 B2B SaaS companies on why nearly half lost organic traffic while others grew during the AI-era shift — and what separated them."
  canonicalPath="/playbooks/modern-organic-growth-playbook"
>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-eyebrow">S.LAB Research</div>
    <h1 class="hero-title">{hero.title}</h1>
    <p class="hero-subhead">{hero.subhead}</p>
    <a href="#download-form" class="cta-btn">Download the Full Playbook →</a>
  </section>

  <!-- RESEARCH AT A GLANCE -->
  <section class="glance">
    <div class="glance-inner">
      <h2 class="section-h2 centered">Research at a Glance</h2>
      <p class="section-overview">{hero.overview}</p>

      <div class="stats-grid">
        {stats.map(s => (
          <div class="stat-cell">
            <div class="stat-value">{s.value}</div>
            <div class="stat-label">{s.label}</div>
          </div>
        ))}
      </div>

      <!-- Chart card -->
      <div class="chart-card">
        <div class="chart-card-header">
          <h3 class="chart-title">The Traffic Split</h3>
          <div class="chart-legend">
            <span class="legend-declined">&#9679; Declined: 55</span>
            <span class="legend-flat">&#9679; Flat: 19</span>
            <span class="legend-grew">&#9679; Grew: 44</span>
          </div>
        </div>
        <div class="chart-inner">
          <div class="bars-row">
            {chartBars.map(b => (
              <div class="bar-wrapper">
                <div class="bar-col-inner" style="height:200px">
                  <div class={`bar bar-${b.group}`} style={`height:${b.heightPct}`}>
                    <span class="bar-value">{b.value}</span>
                  </div>
                </div>
              </div>
            ))}
          </div>
          <div class="bars-border"></div>
          <div class="labels-row">
            {chartBars.map(b => (
              <div class="bar-label-text">{b.label}</div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- KEY FINDINGS -->
  <section class="findings">
    <div class="findings-inner">
      <h2 class="section-h2 centered">Key Findings from the Data</h2>
      <p class="section-subhead">Five patterns consistently separated the companies that grew from the companies that didn't.</p>
      <div class="findings-list">
        {findings.map(f => (
          <div class="finding-row">
            <div class="finding-n">{f.n}</div>
            <div class="finding-content">
              <h3 class="finding-title">{f.title}</h3>
              <p class="finding-body">{f.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHO THIS IS FOR -->
  <section class="audience">
    <div class="audience-inner">
      <h2 class="section-h2 centered">Who This Playbook Is For</h2>
      <div class="audience-list">
        {audience.map(a => (
          <div class="audience-card">
            <h3 class="audience-label">{a.label}</h3>
            <p class="audience-body">{a.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FEATURED INSIGHT -->
  <section class="insight">
    <div class="insight-inner">
      <h2 class="insight-heading">Search didn't die.<br/>Fragile demand did.</h2>
      <div class="insight-body">
        {hero.whyP1.split('\n\n').map(p => (
          <p class="insight-p">{p}</p>
        ))}
      </div>
    </div>
  </section>

  <!-- WHAT'S INSIDE -->
  <section class="chapters">
    <div class="chapters-inner">
      <h2 class="section-h2 centered">What's inside: Chapter by chapter breakdown</h2>
      <div class="chapters-grid">
        {chapters.map(ch => (
          <div class="chapter-row">
            <div class="chapter-n">{ch.n}</div>
            <div>
              <h3 class="chapter-title">{ch.title}</h3>
              <p class="chapter-body">{ch.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- LEAD FORM -->
  <section class="form-section" id="download-form">
    <div class="form-inner">
      <div class="form-eyebrow">Get the Full Playbook</div>
      <h2 class="form-heading">Download the complete playbook</h2>
      <p class="form-desc">All 11 chapters, figures, methodology, and the full diagnostic framework. You'll also receive future research updates as new findings are published.</p>
      <form
        name="playbook-download"
        method="POST"
        action="/playbooks/success"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="playbook-form"
      >
        <input type="hidden" name="form-name" value="playbook-download" />
        <p class="honeypot"><label>Don't fill this out: <input name="bot-field" /></label></p>
        <div class="field-row">
          <input class="field-input" type="text" name="firstName" placeholder="First name" required autocomplete="given-name" />
          <input class="field-input" type="text" name="lastName" placeholder="Last name" required autocomplete="family-name" />
        </div>
        <input class="field-input" type="email" name="email" placeholder="Work email" required autocomplete="email" />
        <button type="submit" class="form-btn">Download the Playbook</button>
      </form>
      <p class="form-fine">Free. No spam. Unsubscribe anytime.</p>
    </div>
  </section>

  <!-- PUBLISHER / ABOUT -->
  <section class="publisher">
    <div class="publisher-inner">
      <div class="publisher-eyebrow">Publisher</div>
      <h2 class="section-h2 centered">About S.LAB</h2>
      <p class="publisher-body">S.LAB is an organic growth consultancy focused on helping B2B companies build durable demand in the AI era. This playbook is part of S.LAB's ongoing research program examining how organic growth systems expand, decline, and recover as search evolves.</p>
      <a href="/about" class="publisher-link">Learn more about our research and consulting →</a>
    </div>
  </section>

</Layout>

<style>
  /* ── Shared ── */
  .section-h2 {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: clamp(28px, 3.5vw, 42px);
    letter-spacing: -0.03em;
    line-height: 1.08;
    color: hsl(var(--foreground));
    margin: 0 0 36px;
  }
  .centered { text-align: center; }
  .section-overview {
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.8;
    color: hsl(var(--foreground));
    max-width: 700px;
    margin: 0 auto 44px;
    text-align: center;
  }
  .section-subhead {
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.8;
    color: hsl(var(--foreground));
    max-width: 640px;
    margin: 0 auto 56px;
    text-align: center;
  }
  .cta-btn {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: hsl(var(--cobalt));
    color: #FAF7F1;
    padding: 16px 32px;
    border-radius: 3px;
    text-decoration: none;
    transition: background 0.15s;
  }
  .cta-btn:hover { background: hsl(var(--cobalt-deep)); color: #FAF7F1; }

  /* ── Hero ── */
  .hero {
    max-width: 860px;
    margin: 0 auto;
    padding: 96px 24px 140px;
    min-height: 88vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .hero-eyebrow {
    font-family: var(--font-heading);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: hsl(var(--cobalt));
    margin-bottom: 20px;
  }
  .hero-title {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: clamp(44px, 6vw, 72px);
    letter-spacing: -0.04em;
    line-height: 1.04;
    color: hsl(var(--foreground));
    margin: 0 0 24px;
  }
  .hero-subhead {
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.75;
    color: hsl(var(--foreground));
    max-width: 640px;
    margin: 0 auto 36px;
  }

  /* ── Research at a Glance ── */
  .glance {
    padding: 56px 24px 80px;
  }
  .glance-inner {
    max-width: 1120px;
    margin: 0 auto;
  }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: hsl(var(--foreground) / 0.08);
    border: 1px solid hsl(var(--foreground) / 0.08);
    border-radius: 6px;
    overflow: hidden;
    margin-bottom: 56px;
  }
  .stat-cell {
    background: hsl(var(--background));
    padding: 32px 16px;
    text-align: center;
  }
  .stat-value {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: 34px;
    letter-spacing: -0.03em;
    color: hsl(var(--cobalt));
    line-height: 1;
  }
  .stat-label {
    font-family: var(--font-heading);
    font-size: 11px;
    font-weight: 500;
    color: hsl(var(--foreground));
    margin-top: 8px;
    line-height: 1.4;
  }

  /* Chart card */
  .chart-card {
    background: hsl(var(--card));
    border-radius: 8px;
    padding: 48px;
  }
  .chart-card-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 36px;
  }
  .chart-title {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: 26px;
    letter-spacing: -0.03em;
    margin: 0;
    color: hsl(var(--foreground));
  }
  .chart-legend {
    display: flex;
    gap: 16px;
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 700;
    flex-wrap: wrap;
  }
  .legend-declined { color: oklch(0.46 0.13 26); }
  .legend-flat     { color: hsl(var(--foreground) / 0.55); }
  .legend-grew     { color: hsl(var(--cobalt)); }

  .chart-inner {
    background: hsl(var(--background));
    border-radius: 6px;
    padding: 40px 32px 28px;
  }
  .bars-row {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 20px;
    align-items: flex-end;
  }
  .bar-wrapper {
    width: 100%;
    height: 200px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }
  .bar-col-inner {
    width: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }
  .bar {
    position: relative;
    width: 100%;
    max-width: 52px;
    border-radius: 4px 4px 0 0;
  }
  .bar-declined { background: oklch(0.46 0.13 26); }
  .bar-flat     { background: hsl(var(--foreground) / 0.28); }
  .bar-grew     { background: hsl(var(--cobalt)); }
  .bar-value {
    position: absolute;
    left: 50%;
    top: -26px;
    transform: translateX(-50%);
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: 18px;
    color: hsl(var(--foreground));
    white-space: nowrap;
  }
  .bars-border {
    border-bottom: 1px solid hsl(var(--foreground) / 0.12);
    margin-top: 0;
  }
  .labels-row {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 20px;
    margin-top: 16px;
  }
  .bar-label-text {
    font-family: var(--font-heading);
    font-size: 11.5px;
    font-weight: 500;
    color: hsl(var(--foreground) / 0.55);
    text-align: center;
    line-height: 1.3;
  }

  /* ── Findings ── */
  .findings {
    background: hsl(var(--background));
    padding: 88px 24px;
  }
  .findings-inner {
    max-width: 900px;
    margin: 0 auto;
  }
  .findings-list {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .finding-row {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 20px;
    border-bottom: 1px solid hsl(var(--foreground) / 0.10);
    padding-bottom: 36px;
  }
  .finding-n {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: 40px;
    letter-spacing: -0.03em;
    color: hsl(var(--cobalt));
    line-height: 1;
  }
  .finding-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(22px, 3vw, 28px);
    letter-spacing: -0.03em;
    margin: 0 0 10px;
    color: hsl(var(--foreground));
  }
  .finding-body {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.8;
    color: hsl(var(--foreground));
    margin: 0;
  }

  /* ── Audience ── */
  .audience {
    max-width: 1120px;
    margin: 0 auto;
    padding: 88px 24px 96px;
  }
  .audience-inner { max-width: 720px; margin: 0 auto; }
  .audience-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .audience-card {
    background: hsl(var(--background));
    border: 1px solid hsl(var(--foreground) / 0.08);
    border-radius: 8px;
    padding: 32px;
  }
  .audience-label {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(20px, 2.4vw, 24px);
    letter-spacing: -0.03em;
    margin: 0 0 12px;
    color: hsl(var(--foreground));
  }
  .audience-body {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.78;
    color: hsl(var(--foreground));
    margin: 0;
  }

  /* ── Featured Insight ── */
  .insight {
    background: hsl(var(--card));
    padding: 160px 24px;
  }
  .insight-inner {
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
  }
  .insight-heading {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: clamp(36px, 5.5vw, 64px);
    letter-spacing: -0.04em;
    line-height: 1.08;
    color: hsl(var(--foreground));
    margin: 0 0 32px;
  }
  .insight-body {
    max-width: 640px;
    margin: 0 auto;
  }
  .insight-p {
    font-family: var(--font-body);
    font-size: 19px;
    line-height: 1.8;
    color: hsl(var(--foreground));
    margin: 0 0 20px;
  }
  .insight-p:last-child { margin-bottom: 0; }

  /* ── Chapters ── */
  .chapters {
    max-width: 1120px;
    margin: 0 auto;
    padding: 96px 24px;
  }
  .chapters-inner { max-width: 1040px; margin: 0 auto; }
  .chapters-grid {
    display: grid;
    grid-template-columns: 1fr;
    column-gap: 56px;
  }
  @media (min-width: 640px) {
    .chapters-grid { grid-template-columns: repeat(2, 1fr); }
  }
  .chapter-row {
    display: flex;
    gap: 16px;
    padding: 20px 0;
    border-bottom: 1px solid hsl(var(--foreground) / 0.08);
  }
  .chapter-n {
    font-family: var(--font-heading);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.10em;
    color: hsl(var(--foreground) / 0.35);
    padding-top: 5px;
    flex-shrink: 0;
    width: 20px;
  }
  .chapter-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 19px;
    letter-spacing: -0.02em;
    margin: 0 0 5px;
    color: hsl(var(--foreground));
  }
  .chapter-body {
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.55;
    color: hsl(var(--foreground) / 0.55);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── Form ── */
  .form-section {
    background: hsl(var(--foreground));
    padding: 100px 24px;
  }
  .form-inner {
    max-width: 480px;
    margin: 0 auto;
    text-align: center;
  }
  .form-eyebrow {
    font-family: var(--font-heading);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #7C5CFF;
    margin-bottom: 14px;
  }
  .form-heading {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: clamp(22px, 2.8vw, 30px);
    letter-spacing: -0.03em;
    color: hsl(var(--background));
    margin: 0 0 14px;
  }
  .form-desc {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.7;
    color: hsl(var(--background) / 0.85);
    margin: 0 0 36px;
  }
  .honeypot { display: none; }
  .playbook-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-align: left;
  }
  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .field-input {
    font-family: var(--font-body);
    font-size: 15px;
    padding: 14px 16px;
    border-radius: 4px;
    border: 1px solid hsl(var(--background) / 0.18);
    background: hsl(var(--background) / 0.05);
    color: hsl(var(--background));
    width: 100%;
  }
  .field-input::placeholder { color: hsl(var(--background) / 0.40); }
  .field-input:focus { outline: none; border-color: hsl(var(--cobalt)); }
  .form-btn {
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: hsl(var(--cobalt));
    color: #FAF7F1;
    padding: 16px;
    border-radius: 4px;
    border: none;
    margin-top: 6px;
    cursor: pointer;
    transition: background 0.15s;
